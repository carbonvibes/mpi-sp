{
    "ociVersion": "1.0.0",
    "platform": {
        "os": "linux",
        "arch": "amd64"
    },
    "process": {
        "terminal": true,
        "user": {
            "uid": 1001,
            "gid": 0
        },
        "args": [
            "/bin/bash"
        ],
        "env": [
            "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "TERM=xterm"
        ],
        "cwd": "/home/user"
    },
    "root": {
        "path": "rootfs",
        "readonly": false
    },
    "linux": {
        "namespaces": [
            {
                "type": "network"
            }
        ],
        "devices": [
            {
                "path": "/dev/random",
                "type": "b",
                "major": 1,
                "minor": 8
            },
            {
                "path": "/dev/tty",
                "type": "b",
                "major": 1,
                "minor": 9
            }
        ],
        "cgroupsPath": "/mycontainer"
    }
}