{
    "ociVersion": "1.2.0",
    "platform": {
        "os": "linux",
        "arch": "amd64"
    },
    "process": {
        "terminal": true,
        "user": {
            "uid": 1001,
            "gid": 48437
        },
        "args": [
            "/bin/sh"
        ],
        "env": [
            "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        ],
        "cwd": "/"
    },
    "root": {
        "path": "rootfs",
        "readonly": true
    },
    "linux": {
        "namespaces": [
            {
                "type": "pid"
            }
        ],
        "devices": [],
        "cgroupsPath": "/mycontainer"
    },
    "mounts": [
        {
            "destination": "/proc",
            "type": "proc",
            "source": "sysfs"
        }
    ],
    "annotations": {
        "com.example.key1": "value2"
    }
}