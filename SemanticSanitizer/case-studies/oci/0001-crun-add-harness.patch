+      mkdir ("rootfs", 0755);
+      mkdir ("rootfs/tmp", 0755);
+      mkdir ("rootfs/proc", 0755);
+      mkdir ("rootfs/sys", 0755);
+      mkdir ("rootfs/dev", 0755);
+      mkdir ("rootfs/dev/shm", 0755);
+
+      libcrun_error_t err = NULL;
+      cleanup_container libcrun_container_t *container = NULL;
+      int ret, first_argument = 0;
+
+      arguments.argc = argc;
+      arguments.argv = argv;
+
+      fill_handler_from_argv0 (argv[0], &arguments);
+      argp_parse (&argp, argc, argv, ARGP_IN_ORDER, &first_argument, &arguments);
 
-  int command_argc = argc - first_argument;
-  cleanup_free char **command_argv = copy_args (argv + first_argument, command_argc);
-  command_argv[0] = argv[0];
+      crun_context.preserve_fds = 0;
+      crun_context.listen_fds = 0;
 
-  ret = command->handler (&arguments, command_argc, command_argv, &err);
-  if (ret && err)
-    libcrun_fail_with_error (err->status, "%s", err->msg);
+      char container_id[20];
+      rand_str (container_id, sizeof (container_id) - 1);
+
+      ret = init_libcrun_context (&crun_context, container_id, &arguments, &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          continue;
+        }
 
-  return ret;
+      container = libcrun_container_load_from_file (argv[1], &err);
+      if (container == NULL)
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          continue;
+        }
+
+      /* Clamp memory limit to 128 MiB minimum.  The grammar generates limits via
+         [0-9]+ which produces values like 1 or 100 bytes; crun joins the container
+         cgroup before exec so a tiny limit OOM-kills crun itself, crashing the
+         forkserver.  Clamping preserves coverage of the cgroup setup path. */
+      if (container->container_def->linux
+          && container->container_def->linux->resources
+          && container->container_def->linux->resources->memory
+          && container->container_def->linux->resources->memory->limit_present
+          && container->container_def->linux->resources->memory->limit >= 0
+          && container->container_def->linux->resources->memory->limit < 128L * 1024 * 1024)
+        container->container_def->linux->resources->memory->limit = 128L * 1024 * 1024;
+
+      /* Exercise a full container lifecycle instead of a single run: create
+         (detached) -> state -> kill -> delete.  This hits crun's create/state/
+         kill/delete code paths (setup, status lookup, teardown).  The container
+         payload is a static exit(0) blob, so the init exits immediately; that is
+         fine — the lifecycle still runs its full setup/lookup/teardown logic and
+         the error paths (e.g. kill on an already-exited container) are valuable
+         coverage too.  On any libcrun error we release the error, jump to the
+         cleanup backstops, and continue — never return/abort, which would tear
+         down the persistent AFL forkserver.  exec/update are deliberately
+         deferred (they need extra parsed inputs).
+
+         Mirrors the real command handlers:
+           - create: src/create.c -> libcrun_container_create (context, container,
+             options=0, err).  libcrun_container_create forces context->detach=1
+             internally; we set it explicitly to match `create`/`run -d` intent.
+           - state:  src/state.c  -> libcrun_container_state (context, id, stdout, err).
+           - kill:   src/kill.c   -> libcrun_container_kill (context, id, signal, err)
+             with signal as a string (str2sig).
+           - delete: src/delete.c -> libcrun_container_delete (context, def=NULL,
+             id, force, err); def=NULL makes delete read the config from the state
+             dir, and force=true tears down even a still-"running" container. */
+      crun_context.detach = true;
+
+      ret = libcrun_container_create (&crun_context, container, 0, &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          goto cleanup;
+        }
+
+      ret = libcrun_container_state (&crun_context, container_id, stdout, &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          goto cleanup;
+        }
+
+      ret = libcrun_container_kill (&crun_context, container_id, "SIGKILL", &err);
+      if (UNLIKELY (ret < 0))
+        libcrun_error_release (&err);
+
+    cleanup:
+      /* Always force-delete: proper teardown (hooks, cgroup, state dir) on the
+         happy path, a harmless no-op error when there's nothing to delete.  Then
+         hard backstops so a failed or partial delete can't leak — /run is tmpfs,
+         and a leaked /run/crun/<id> eats RAM until /run fills (we hit ~955k once). */
+      libcrun_container_delete (&crun_context, NULL, container_id, true, &err);
+      libcrun_error_release (&err);
+      cleanup_state_dir (container_id);
+      cleanup_cgroup (container_id);
+      rmdir_rec ("rootfs");
+      libcrun_container_free (container);
+      container = NULL;
+    }
+
+  return 0;
 }
