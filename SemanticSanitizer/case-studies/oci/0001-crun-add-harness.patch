+}
+
+// force-remove a container's state dir (/run/crun/<id>).  crun's own delete
+// normally does this, but a config that fails create after the dir is written
+// leaves it behind, and /run is tmpfs — leaked state dirs eat RAM until /run fills.
+static void
+cleanup_state_dir (const char *container_id)
+{
+  char path[PATH_MAX];
+  snprintf (path, sizeof (path), "/run/crun/%s", container_id);
+  rmdir_rec (path);
+}
+
+#ifdef ENABLE_ASAN
+/* Called by ASAN during its own init — before main() and before constructors.
+   This is the only reliable way to set ASAN options from code; setenv() inside
+   a constructor fires too late (ASAN has already parsed its options by then). */
+const char *
+__asan_default_options (void)
+{
+  return "abort_on_error=1:"
+         "detect_leaks=0:"
+         "log_path=/tmp/asan_reports/crun_asan:"
+         "symbolize=1:"
+         "print_stacktrace=1";
+}
+
+__attribute__ ((constructor))
+static void
+setup_asan_dir (void)
+{
+  mkdir ("/tmp/asan_reports", 0755);
+}
 #endif
 
