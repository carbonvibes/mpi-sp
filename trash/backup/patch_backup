@@ -436,40 +446,188 @@ copy_args (char **argv, int argc)
   return buff;
 }
 
+void
+rand_str (char *buf, size_t len)
+{
+  static const char charset[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+  for (size_t i = 0; i < len; i++)
+    {
+      int key = rand () % (sizeof (charset) - 1);
+      buf[i] = charset[key];
+    }
+  buf[len] = '\0';
+}
+
+// recursively rmdir a cgroup subtree (no unlink — cgroup files are not removable)
+static void
+cleanup_cgroup (const char *container_id)
+{
+  char path[PATH_MAX];
+  snprintf (path, sizeof (path), "/sys/fs/cgroup/%s", container_id);
+
+  /* Kill any lingering processes before attempting removal. */
+  char procs_path[PATH_MAX];
+  snprintf (procs_path, sizeof (procs_path), "%s/cgroup.procs", path);
+  FILE *f = fopen (procs_path, "r");
+  if (f)
+    {
+      pid_t pid;
+      while (fscanf (f, "%d", &pid) == 1)
+        kill (pid, SIGKILL);
+      fclose (f);
+    }
+
+  /* Recursively rmdir sub-cgroups (leaves first), then the container cgroup. */
+  DIR *dir = opendir (path);
+  if (dir)
+    {
+      struct dirent *entry;
+      while ((entry = readdir (dir)) != NULL)
+        {
+          if (entry->d_type != DT_DIR)
+            continue;
+          if (strcmp (entry->d_name, ".") == 0 || strcmp (entry->d_name, "..") == 0)
+            continue;
+          char sub[PATH_MAX];
+          snprintf (sub, sizeof (sub), "%s/%s", path, entry->d_name);
+          rmdir (sub);
+        }
+      closedir (dir);
+    }
+  rmdir (path);
+}
+
+// recursively delete all files and directories in the given path
 int
-main (int argc, char **argv)
+rmdir_rec (char *path)
 {
-  libcrun_error_t err = NULL;
-  int ret, first_argument = 0;
+  // Drain all stacked mounts (OCI spec bind-mounts accumulate per iteration in persistent mode)
+  while (umount2 (path, MNT_DETACH) == 0)
+    ;
 
-  arguments.argc = argc;
-  arguments.argv = argv;
+  struct stat st;
+  if (lstat (path, &st) < 0)
+    return -1;
 
-#ifdef DYNLOAD_LIBCRUN
-  if (ensure_cloned_binary () < 0)
+  if (S_ISDIR (st.st_mode))
     {
-      fprintf (stderr, "Failed to re-execute libcrun via memory file descriptor\n");
-      _exit (EXIT_FAILURE);
+      DIR *dir = opendir (path);
+      if (! dir)
+        return -1;
+      struct dirent *entry;
+      while ((entry = readdir (dir)) != NULL)
+        {
+          if (strcmp (entry->d_name, ".") == 0 || strcmp (entry->d_name, "..") == 0)
+            continue;
+          char buf[PATH_MAX];
+          snprintf (buf, sizeof (buf), "%s/%s", path, entry->d_name);
+          if (rmdir_rec (buf) < 0)
+            {
+              closedir (dir);
+              return -1;
+            }
+        }
+      closedir (dir);
+      return rmdir (path);
     }
-  /* Resolve all libcrun weak dependencies.  */
-  if (dlopen ("libcrun.so", RTLD_GLOBAL | RTLD_DEEPBIND | RTLD_LAZY) == NULL)
-    error (EXIT_FAILURE, 0, "could not load `libcrun.so`: `%s`", dlerror ());
-#endif
+  else
+    {
+      return unlink (path);
+    }
+}
+
+int
+main (int argc, char **argv)
+{
+  if (argc != 2)
+    return 1;
+
+  srand (time (NULL));
+
+  while (__AFL_LOOP (1))
+    {
+      rmdir_rec ("rootfs");
+      mkdir ("rootfs", 0755);
+      mkdir ("rootfs/tmp", 0755);
+      mkdir ("rootfs/proc", 0755);
+      mkdir ("rootfs/sys", 0755);
+      mkdir ("rootfs/dev", 0755);
+      mkdir ("rootfs/dev/shm", 0755);
+
+      libcrun_error_t err = NULL;
+      cleanup_container libcrun_container_t *container = NULL;
+      int ret, first_argument = 0;
+
+      arguments.argc = argc;
+      arguments.argv = argv;
 
-  fill_handler_from_argv0 (argv[0], &arguments);
-  argp_parse (&argp, argc, argv, ARGP_IN_ORDER, &first_argument, &arguments);
+      fill_handler_from_argv0 (argv[0], &arguments);
+      argp_parse (&argp, argc, argv, ARGP_IN_ORDER, &first_argument, &arguments);
 
-  command = get_command (argv[first_argument]);
-  if (command == NULL)
-    libcrun_fail_with_error (0, "unknown command %s", argv[first_argument]);
+      crun_context.preserve_fds = 0;
+      crun_context.listen_fds = 0;
 
-  int command_argc = argc - first_argument;
-  cleanup_free char **command_argv = copy_args (argv + first_argument, command_argc);
-  command_argv[0] = argv[0];
+      char container_id[20];
+      rand_str (container_id, sizeof (container_id) - 1);
+
+      ret = init_libcrun_context (&crun_context, container_id, &arguments, &err);
+      if (UNLIKELY (ret < 0))
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          continue;
+        }
 
-  ret = command->handler (&arguments, command_argc, command_argv, &err);
-  if (ret && err)
-    libcrun_fail_with_error (err->status, "%s", err->msg);
+      container = libcrun_container_load_from_file (argv[1], &err);
+      if (container == NULL)
+        {
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          continue;
+        }

+      /* Clamp memory limit to 128 MiB minimum.  The grammar generates limits via
+         [0-9]+ which produces values like 1 or 100 bytes; crun joins the container
+         cgroup before exec so a tiny limit OOM-kills crun itself, crashing the
+         forkserver.  Clamping preserves coverage of the cgroup setup path. */
+      if (container->container_def->linux
+          && container->container_def->linux->resources
+          && container->container_def->linux->resources->memory
+          && container->container_def->linux->resources->memory->limit_present
+          && container->container_def->linux->resources->memory->limit >= 0
+          && container->container_def->linux->resources->memory->limit < 128L * 1024 * 1024)
+        container->container_def->linux->resources->memory->limit = 128L * 1024 * 1024;
+
-  return ret;
+      ret = libcrun_container_run (&crun_context, container, 0, &err);
+      cleanup_cgroup (container_id);
+      if (UNLIKELY (ret < 0))
+        {
+          /* status==0 + any sync-channel "read from" message means the child
+             closed the socket/pipe/fifo without sending an error — it was
+             killed by a signal (SIGSEGV, SIGABRT, …) before finishing setup.
+             Explicit list avoids false-positives from unrelated read errors
+             ("read from `/proc/sys/…`", "read from `cpuset.cpus`", etc.)
+             that can have errno==0 in edge cases.
+             Re-raise SIGSEGV so AFL records this run as a crash. */
+          int child_crashed = (err && err->status == 0 && err->msg
+                               && (strstr (err->msg, "read from sync socket")
+                                   || strstr (err->msg, "read from sync pipe")
+                                   || strstr (err->msg, "read from the exec fifo")
+                                   || strstr (err->msg, "read from the init process")));
+          libcrun_error_release (&err);
+          rmdir_rec ("rootfs");
+          if (child_crashed)
+            raise (SIGSEGV);
+          continue;
+        }
+
+      rmdir_rec ("rootfs");
+      libcrun_container_free (container);
+      container = NULL;
+      /* Re-raise container-kill signal so AFL records this run as a crash. */
+      if (ret > 128)
+        raise (ret - 128);
+    }
+
+  return 0;
 }
